table _Measures
	lineageTag: 1722df40-649b-4611-abb0-2a3e30f24623

	measure 'DQ Pass Rate' = 1 - DIVIDE ( SUM ( mart_dq_health[rows_failed] ), SUM ( mart_dq_health[rows_checked] ) )
		formatString: 0.00%
		lineageTag: b25fe907-db8e-4bdb-ade4-7fbf4418d16d

	measure 'Quarantined Rows' = SUM ( mart_quarantine[rows] )
		formatString: #,0
		lineageTag: 95accd14-77af-472a-ae74-2fd1b1a54a3c

	measure 'Open Incidents' = CALCULATE ( COUNTROWS ( mart_incidents ), mart_incidents[status] = "OPEN" )
		formatString: #,0
		lineageTag: e2e6284e-128e-463c-b375-bcb66443d7e6

	measure 'SLA Breached' = CALCULATE ( COUNTROWS ( mart_incidents ), mart_incidents[sla_status] = "BREACHED" )
		formatString: #,0
		lineageTag: 3bd93f46-75a3-4a04-a696-d7cc5676c603

	measure 'Incident Count' = COUNTROWS ( mart_incidents )
		formatString: #,0
		lineageTag: 71423f10-cb8e-4c84-9970-23f0418dbf39

	measure 'Resolved In SLA' = CALCULATE ( COUNTROWS ( mart_incidents ), mart_incidents[status] = "RESOLVED", mart_incidents[sla_status] = "RESOLVED_IN_SLA" ) + 0
		formatString: #,0
		lineageTag: b51e6a71-e5a3-4a81-93bb-2a1ee7983b46

	measure 'Avg Minutes To Ack' = AVERAGE ( mart_incidents[minutes_to_ack] )
		formatString: #,0.0
		lineageTag: 9d2b3069-dec2-45ee-8ce7-a364a441f4c0

	measure 'EUR At Risk' = CALCULATE ( SUM ( mart_revenue_assurance[amount_at_risk_eur] ), mart_revenue_assurance[is_data_defect] = TRUE () )
		formatString: € #,0
		lineageTag: e5a2093c-c38f-4bb0-8b3a-98a224c08410

	measure 'Gross EUR At Risk' = SUM ( mart_revenue_assurance[amount_at_risk_eur] )
		formatString: € #,0
		lineageTag: ae0d603a-77f4-4647-aede-7a15b12e3caf

	measure 'Mismatched Rows' = SUM ( mart_revenue_assurance[rows_mismatched] )
		formatString: #,0
		lineageTag: c869487b-6a5f-49b1-b811-9e078685e7fa

	measure 'Active Customers' = CALCULATE ( COUNTROWS ( mart_customer_360 ), mart_customer_360[status] = "ACTIVE" )
		formatString: #,0
		lineageTag: 7afa42b3-1e74-4e40-9af7-66f0883befe7

	measure 'Customer Count' = DISTINCTCOUNT ( mart_customer_360[customer_id] )
		formatString: #,0
		lineageTag: 1cb7cae3-2f5e-460f-ac35-4d2f6f81bf95

	measure 'Billed EUR' = SUM ( mart_customer_360[billed_eur] )
		formatString: € #,0
		lineageTag: 75518911-0d5c-442b-b0e4-b576b0c1a5a8

	measure 'Paid EUR' = SUM ( mart_customer_360[paid_eur] )
		formatString: € #,0
		lineageTag: 026d8cf6-1907-453c-bff3-8f06ca4e7052

	measure 'Unpaid EUR' = SUM ( mart_customer_360[unpaid_eur] )
		formatString: € #,0
		lineageTag: bbf807ea-c369-4a4b-94e3-4d90cc5a25fc

	measure 'Collection Rate' = DIVIDE ( [Paid EUR], [Billed EUR] )
		formatString: 0.00%
		lineageTag: fbaad7ee-4125-446b-a822-8a4c76aacd68

	measure 'Network Records' = SUM ( mart_network_daily[records] )
		formatString: #,0
		lineageTag: 57fbb111-a3e1-4dc6-8a59-1dbcae1f5739

	measure 'Voice Minutes' = CALCULATE ( SUM ( mart_network_daily[minutes] ), mart_network_daily[event_type] = "VOICE" )
		formatString: #,0
		lineageTag: e558fb28-c67b-44ff-9d18-28a370745cbc

	measure 'Data GB' = DIVIDE ( SUM ( mart_network_daily[data_mb] ), 1024 )
		formatString: #,0.00
		lineageTag: 529743a7-85dc-4a66-9f56-e453ef4073ff

	measure 'Drop Rate' =
			DIVIDE (
				CALCULATE ( SUM ( mart_network_daily[dropped] ), mart_network_daily[event_type] = "VOICE" ),
				CALCULATE ( SUM ( mart_network_daily[records] ), mart_network_daily[event_type] = "VOICE" )
			)
		formatString: 0.00%
		lineageTag: 40bfd148-c350-41ce-a1f8-821e258226d6

	measure 'App Events' = SUM ( mart_app_usage[events] )
		formatString: #,0
		lineageTag: 7455539b-cd96-4097-98f8-15c5e48f266d

	measure 'Partner Cost EUR' = SUM ( mart_partner_usage[amount_eur] )
		formatString: € #,0
		lineageTag: 4912c3b8-e5c1-43d3-931a-a3ff7b7cbb14

	measure 'Unknown Partner Cost EUR' = SUM ( mart_partner_usage[amount_unknown_customer_eur] )
		formatString: € #,0
		lineageTag: 4cde703d-35b1-4a82-bb20-bf353f78377c

	measure 'Oldest Quarantine Age Days' =
			VAR OldestAt = MIN ( mart_quarantine[oldest_quarantined_at] )
			RETURN IF ( NOT ISBLANK ( OldestAt ), DATEDIFF ( OldestAt, NOW (), DAY ) )
		formatString: #,0
		lineageTag: 90835392-1f10-454e-a490-9e141018911a

	measure 'Crash Share' =
			DIVIDE (
				CALCULATE ( SUM ( mart_app_usage[events] ), mart_app_usage[event_type] = "crash" ),
				SUM ( mart_app_usage[events] )
			)
		formatString: 0.00%
		lineageTag: e54032c6-d69a-4511-81db-c3a5cee9e17e

	measure 'DQ Trend Pass Rate' = 1 - DIVIDE ( SUM ( mart_dq_trend[rows_failed] ), SUM ( mart_dq_trend[rows_checked] ) )
		formatString: 0.00%
		lineageTag: db13c30c-e8e7-4bed-8dba-33fd128ed954

	measure 'Voice Calls' = SUM ( mart_cell_quality[voice_calls] )
		formatString: #,0
		lineageTag: 475b6783-6e1d-4072-96b8-9a3981c42dd2

	/// Drop rate for cells with at least 20 voice calls, so one-call cells do not top the chart.
	measure 'Cell Drop Rate' =
			VAR Calls = SUM ( mart_cell_quality[voice_calls] )
			RETURN IF ( Calls >= 20, DIVIDE ( SUM ( mart_cell_quality[dropped_calls] ), Calls ) )
		formatString: 0.00%
		lineageTag: aa10b245-1a69-434c-a693-f903f4e7cca4

	measure 'Partner Cost Unknown Share' = DIVIDE ( [Unknown Partner Cost EUR], [Partner Cost EUR] )
		formatString: 0.00%
		lineageTag: d28867b5-f19d-46b3-898c-1d3bf299564e





















































	/// UI: report helper
	measure 'UI Records Delta' =
			VAR maxD = CALCULATE ( MAX ( mart_network_daily[usage_date] ), ALLSELECTED ( mart_network_daily ) )
			VAR cur = CALCULATE ( [Network Records], mart_network_daily[usage_date] > maxD - 7, mart_network_daily[usage_date] <= maxD )
			VAR prev = CALCULATE ( [Network Records], mart_network_daily[usage_date] > maxD - 14, mart_network_daily[usage_date] <= maxD - 7 )
			VAR d = DIVIDE ( cur - prev, prev )
			RETURN IF ( ISBLANK ( d ), "no prior week", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0%" ) & " vs last week" )
		isHidden

	/// UI: report helper
	measure 'UI Voice Delta' =
			VAR maxD = CALCULATE ( MAX ( mart_network_daily[usage_date] ), ALLSELECTED ( mart_network_daily ) )
			VAR cur = CALCULATE ( [Voice Minutes], mart_network_daily[usage_date] > maxD - 7, mart_network_daily[usage_date] <= maxD )
			VAR prev = CALCULATE ( [Voice Minutes], mart_network_daily[usage_date] > maxD - 14, mart_network_daily[usage_date] <= maxD - 7 )
			VAR d = DIVIDE ( cur - prev, prev )
			RETURN IF ( ISBLANK ( d ), "no prior week", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0%" ) & " vs last week" )
		isHidden

	/// UI: report helper
	measure 'UI Data Delta' =
			VAR maxD = CALCULATE ( MAX ( mart_network_daily[usage_date] ), ALLSELECTED ( mart_network_daily ) )
			VAR cur = CALCULATE ( [Data GB], mart_network_daily[usage_date] > maxD - 7, mart_network_daily[usage_date] <= maxD )
			VAR prev = CALCULATE ( [Data GB], mart_network_daily[usage_date] > maxD - 14, mart_network_daily[usage_date] <= maxD - 7 )
			VAR d = DIVIDE ( cur - prev, prev )
			RETURN IF ( ISBLANK ( d ), "no prior week", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0%" ) & " vs last week" )
		isHidden

	/// UI: report helper
	measure 'UI Drop Delta' =
			VAR maxD = CALCULATE ( MAX ( mart_network_daily[usage_date] ), ALLSELECTED ( mart_network_daily ) )
			VAR cur = CALCULATE ( [Drop Rate], mart_network_daily[usage_date] > maxD - 7, mart_network_daily[usage_date] <= maxD )
			VAR prev = CALCULATE ( [Drop Rate], mart_network_daily[usage_date] > maxD - 14, mart_network_daily[usage_date] <= maxD - 7 )
			RETURN IF ( ISBLANK ( prev ), "no prior week", IF ( cur >= prev, "▲ ", "▼ " ) & FORMAT ( ABS ( cur - prev ) * 100, "0.0" ) & " pt vs last week" )
		isHidden

	/// UI: report helper
	measure 'UI Partner Status' = IF ( [Unknown Partner Cost EUR] > 0, "needs matching", "all matched" )
		isHidden

	/// UI: report helper
	measure 'UI Days Network' = FORMAT ( DISTINCTCOUNT ( mart_network_daily[usage_date] ), "0" ) & IF ( DISTINCTCOUNT ( mart_network_daily[usage_date] ) = 1, " day", " days" )
		isHidden

	/// UI: report helper
	measure 'UI Days App' = FORMAT ( DISTINCTCOUNT ( mart_app_usage[event_date] ), "0" ) & IF ( DISTINCTCOUNT ( mart_app_usage[event_date] ) = 1, " day", " days" )
		isHidden

	/// UI: report helper
	measure 'UI Versions App' = FORMAT ( DISTINCTCOUNT ( mart_app_usage[app_version] ), "0" ) & IF ( DISTINCTCOUNT ( mart_app_usage[app_version] ) = 1, " version", " versions" )
		isHidden

	/// UI: report helper
	measure 'UI Months Partner' = FORMAT ( DISTINCTCOUNT ( mart_partner_usage[period_start] ), "0" ) & IF ( DISTINCTCOUNT ( mart_partner_usage[period_start] ) = 1, " month", " months" )
		isHidden

	/// UI: report helper
	measure 'Crash Share Track' =
			VAR mx = MAXX ( ALLSELECTED ( mart_app_usage[app_version] ), [Crash Share] )
			RETURN IF ( NOT ISBLANK ( [Crash Share] ), mx * 1.08 - [Crash Share] )
		isHidden


	/// UI: report helper
	measure 'Cell Drop Track' =
			VAR mx = MAXX ( ALLSELECTED ( mart_cell_quality[cell_id] ), [Cell Drop Rate] )
			RETURN IF ( NOT ISBLANK ( [Cell Drop Rate] ), mx * 1.08 - [Cell Drop Rate] )
		isHidden

	/// UI: report helper
	measure 'App Events K' = DIVIDE ( [App Events], 1000 )
		formatString: #,0
		isHidden

	/// UI: report helper
	measure 'Network Records M' = DIVIDE ( [Network Records], 1000000 )
		formatString: 0.0
		isHidden

	/// UI: report helper
	measure 'Partner Cost K' = DIVIDE ( [Partner Cost EUR], 1000 )
		formatString: € #,0
		isHidden

	/// UI: report helper
	measure 'UI Open 7d' =
			VAR maxD = CALCULATE ( MAX ( mart_incidents[opened_at] ), ALLSELECTED ( mart_incidents ) )
			VAR n = CALCULATE ( [Incident Count], mart_incidents[opened_at] > maxD - 7 )
			RETURN FORMAT ( n, "0" ) & " opened in last 7 days" 
		isHidden

	/// UI: report helper
	measure 'UI SLA Policy' = "P1 1h · P2 4h · P3 24h · P4 72h"
		isHidden

	/// UI: report helper
	measure 'UI Quarantine Datasets' = FORMAT ( DISTINCTCOUNT ( mart_quarantine[dataset] ), "0" ) & " datasets affected"
		isHidden

	/// UI: report helper
	measure 'UI Active Share' = FORMAT ( DIVIDE ( [Active Customers], [Customer Count] ), "0%" ) & " of customers"
		isHidden

	/// UI: report helper
	measure 'UI Unpaid Owe' =
			VAR n = CALCULATE ( [Customer Count], mart_customer_360[unpaid_eur] > 0 )
			RETURN FORMAT ( n, "#,0" ) & " customers owe" 
		isHidden

	/// UI: report helper
	measure 'UI DQ Delta' =
			VAR maxD = CALCULATE ( MAX ( mart_dq_trend[run_date] ), ALLSELECTED ( mart_dq_trend ) )
			VAR prevD = CALCULATE ( MAX ( mart_dq_trend[run_date] ), ALLSELECTED ( mart_dq_trend ), mart_dq_trend[run_date] < maxD )
			VAR cur = CALCULATE ( [DQ Trend Pass Rate], mart_dq_trend[run_date] = maxD )
			VAR prev = CALCULATE ( [DQ Trend Pass Rate], mart_dq_trend[run_date] = prevD )
			RETURN IF ( ISBLANK ( prev ), "latest run", IF ( cur >= prev, "▲ ", "▼ " ) & FORMAT ( ABS ( cur - prev ) * 100, "0.0" ) & " pt vs previous run" )
		isHidden

	/// UI: report helper
	measure 'Failing Rules' = CALCULATE ( COUNTROWS ( mart_dq_health ), mart_dq_health[status] <> "PASS" )
		formatString: #,0
		isHidden

	/// UI: report helper
	measure 'UI Rules Total' = "of " & FORMAT ( COUNTROWS ( mart_dq_health ), "#,0" ) & " rules checked"
		isHidden

	/// UI: report helper
	measure 'UI Oldest Note' = "waiting in quarantine"
		isHidden

	/// UI: report helper
	measure 'UI Runs DQ' = FORMAT ( DISTINCTCOUNT ( mart_dq_trend[run_date] ), "0" ) & IF ( DISTINCTCOUNT ( mart_dq_trend[run_date] ) = 1, " day", " days" )
		isHidden

	/// UI: report helper
	measure 'UI Datasets DQ' = FORMAT ( DISTINCTCOUNT ( mart_dq_health[dataset] ), "0" ) & IF ( DISTINCTCOUNT ( mart_dq_health[dataset] ) = 1, " dataset", " datasets" )
		isHidden

	/// UI: report helper
	measure 'Pass Rate Track' = IF ( NOT ISBLANK ( [DQ Pass Rate] ), 1 - [DQ Pass Rate] )
		formatString: 0.0%
		isHidden

	/// UI: report helper
	measure 'Color Pass Rate' = IF ( [DQ Pass Rate] < 0.95, "#D9363E", "#2F6FDB" )
		isHidden

	/// UI: report helper
	measure 'Color Matrix' =
			VAR v = [DQ Trend Pass Rate]
			RETURN SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0.9, "#FBD5D5", v < 0.98, "#FDECC8", "#D7F2E3" )
		isHidden

	/// UI: report helper
	measure 'Color DQ Status' = IF ( SELECTEDVALUE ( mart_dq_health[status] ) IN { "FAIL", "FAILED" }, "#FDE2E2" )
		isHidden

	/// UI: report helper
	measure 'Font DQ Status' = IF ( SELECTEDVALUE ( mart_dq_health[status] ) IN { "FAIL", "FAILED" }, "#B42318", "#111827" )
		isHidden

	/// UI: report helper
	measure 'UI Risk Delta' =
			VAR lastT = CALCULATE ( MAX ( mart_revenue_assurance_trend[run_ts] ), ALLSELECTED ( mart_revenue_assurance_trend ) )
			VAR prevT = CALCULATE ( MAX ( mart_revenue_assurance_trend[run_ts] ), ALLSELECTED ( mart_revenue_assurance_trend ), mart_revenue_assurance_trend[run_ts] < lastT )
			VAR cur = CALCULATE ( SUM ( mart_revenue_assurance_trend[amount_at_risk_eur] ), mart_revenue_assurance_trend[run_ts] = lastT )
			VAR prev = CALCULATE ( SUM ( mart_revenue_assurance_trend[amount_at_risk_eur] ), mart_revenue_assurance_trend[run_ts] = prevT )
			VAR d = DIVIDE ( cur - prev, prev )
			RETURN IF ( ISBLANK ( d ), "latest run", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0%" ) & " vs previous run" )
		isHidden

	/// UI: report helper
	measure 'UI Gross Note' = "gross: R3 and R6 overlap"
		isHidden

	/// UI: report helper
	measure 'UI Defect Note' = "excludes R10 unpaid invoices"
		isHidden

	/// UI: report helper
	measure 'Checks Failing' = CALCULATE ( COUNTROWS ( mart_revenue_assurance ), mart_revenue_assurance[status] = "FAIL" )
		formatString: #,0
		isHidden

	/// UI: report helper
	measure 'UI Checks Total' = "of " & FORMAT ( COUNTROWS ( mart_revenue_assurance ), "0" ) & " checks"
		isHidden

	/// UI: report helper
	measure 'Cases To Investigate' = COUNTROWS ( mart_recon_mismatches )
		formatString: #,0
		isHidden

	/// UI: report helper
	measure 'UI Latest Run' = "latest reconciliation run"
		isHidden

	/// UI: report helper
	measure 'UI Runs Recon' = FORMAT ( DISTINCTCOUNT ( mart_revenue_assurance_trend[run_id] ), "0" ) & IF ( DISTINCTCOUNT ( mart_revenue_assurance_trend[run_id] ) = 1, " run", " runs" )
		isHidden

	/// UI: report helper
	measure 'UI Mismatch Checks' =
			VAR n = CALCULATE ( COUNTROWS ( mart_revenue_assurance ), mart_revenue_assurance[rows_mismatched] > 0 )
			RETURN "across " & FORMAT ( n, "0" ) & " checks" 
		isHidden

	/// UI: report helper
	measure 'Leak Risk Track' =
			VAR mx = MAXX ( ALLSELECTED ( mart_revenue_assurance[leak_type] ), [Gross EUR At Risk] )
			RETURN IF ( NOT ISBLANK ( [Gross EUR At Risk] ), mx * 1.08 - [Gross EUR At Risk] )
		isHidden

	/// UI: report helper
	measure 'Recon Risk Run' = SUM ( mart_revenue_assurance_trend[amount_at_risk_eur] )
		formatString: € #,0
		isHidden

	/// UI: report helper
	measure 'Color Recon Status' = IF ( SELECTEDVALUE ( mart_revenue_assurance[status] ) IN { "FAIL", "FAILED" }, "#FDE2E2" )
		isHidden

	/// UI: report helper
	measure 'Font Recon Status' = IF ( SELECTEDVALUE ( mart_revenue_assurance[status] ) IN { "FAIL", "FAILED" }, "#B42318", "#111827" )
		isHidden

	/// UI: report helper
	measure 'UI Resolved Share' =
			VAR resolved = CALCULATE ( [Incident Count], mart_incidents[status] = "RESOLVED" )
			RETURN FORMAT ( DIVIDE ( [Resolved In SLA], resolved ), "0%" ) & " of resolved" 
		isHidden

	/// UI: report helper
	measure 'UI Ack Note' = "minutes to acknowledge"
		isHidden

	/// UI: report helper
	measure 'UI Incidents Total' = FORMAT ( [Incident Count], "#,0" ) & " incidents"
		isHidden

	/// UI: report helper
	measure 'UI Teams' = FORMAT ( DISTINCTCOUNT ( mart_incidents[team] ), "0" ) & IF ( DISTINCTCOUNT ( mart_incidents[team] ) = 1, " team", " teams" )
		isHidden

	/// UI: report helper
	measure 'Team Workload Track' =
			VAR mx = MAXX ( ALLSELECTED ( mart_incidents[team] ), [Open Incidents] )
			RETURN IF ( NOT ISBLANK ( [Open Incidents] ), mx * 1.08 - [Open Incidents] )
		isHidden

	/// UI: report helper
	measure 'Color SLA Status' = IF ( SELECTEDVALUE ( mart_incidents[sla_status] ) IN { "BREACHED" }, "#FDE2E2" )
		isHidden

	/// UI: report helper
	measure 'Font SLA Status' = IF ( SELECTEDVALUE ( mart_incidents[sla_status] ) IN { "BREACHED" }, "#B42318", "#111827" )
		isHidden

	/// UI: report helper
	measure 'UI Invoices' = FORMAT ( SUM ( mart_customer_360[invoices] ), "#,0" ) & " invoices"
		isHidden

	/// UI: report helper
	measure 'UI Collected' = FORMAT ( [Collection Rate], "0%" ) & " collected"
		isHidden

	/// UI: report helper
	measure 'UI Plans' = FORMAT ( DISTINCTCOUNT ( mart_customer_360[plan_name] ), "0" ) & IF ( DISTINCTCOUNT ( mart_customer_360[plan_name] ) = 1, " plan", " plans" )
		isHidden

	/// UI: report helper
	measure 'UI Customers Shown' = FORMAT ( [Customer Count], "#,0" ) & " customers"
		isHidden

	/// UI: report helper
	measure 'Unpaid Plan Track' =
			VAR mx = MAXX ( ALLSELECTED ( mart_customer_360[plan_name] ), [Unpaid EUR] )
			RETURN IF ( NOT ISBLANK ( [Unpaid EUR] ), mx * 1.08 - [Unpaid EUR] )
		isHidden

	/// UI5: BI review
	measure 'Target DQ Pass' = 0.98
		formatString: 0%
		isHidden

	/// UI5: BI review
	measure 'Target Drop Rate' = 0.02
		formatString: 0.0%
		isHidden

	/// UI5: BI review
	measure 'Target SLA Compliance' = 0.95
		formatString: 0%
		isHidden

	/// UI5: BI review
	measure 'Target Collection' = 0.95
		formatString: 0%
		isHidden

	/// UI5: BI review
	measure 'Limit Crash Share' = 0.02
		formatString: 0.0%
		isHidden

	/// UI5: BI review
	measure 'SLA Compliance' = DIVIDE ( [Resolved In SLA], CALCULATE ( [Incident Count], mart_incidents[status] = "RESOLVED" ) )
		formatString: 0%
		isHidden

	/// UI5: BI review
	measure 'UI DQ Pill Level' = VAR v = [DQ Pass Rate] RETURN SWITCH ( TRUE (), ISBLANK ( v ), -1, v >= [Target DQ Pass], 0, v >= 0.95, 1, 2 )
		isHidden

	/// UI5: BI review
	measure 'UI DQ Pill' = SWITCH ( [UI DQ Pill Level], 0, "✓ On target (98%)", 1, "! Below 98% target", 2, "✕ Under 95%, critical", "no data" )
		isHidden

	/// UI5: BI review
	measure 'UI DQ Pill Bg' = SWITCH ( [UI DQ Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI DQ Pill Fg' = SWITCH ( [UI DQ Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI SLA Pill Level' = IF ( [SLA Breached] > 0, 2, 0 )
		isHidden

	/// UI5: BI review
	measure 'UI SLA Pill' = IF ( [SLA Breached] > 0, "✕ Deadline missed, act now", "✓ No deadline missed" )
		isHidden

	/// UI5: BI review
	measure 'UI SLA Pill Bg' = SWITCH ( [UI SLA Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI SLA Pill Fg' = SWITCH ( [UI SLA Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI Drop Pill Level' = VAR v = [Drop Rate] RETURN SWITCH ( TRUE (), ISBLANK ( v ), -1, v <= [Target Drop Rate], 0, v <= 0.03, 1, 2 )
		isHidden

	/// UI5: BI review
	measure 'UI Drop Pill' = SWITCH ( [UI Drop Pill Level], 0, "✓ Within 2% limit", 1, "! Above 2% limit", 2, "✕ Above 3%, critical", "no data" )
		isHidden

	/// UI5: BI review
	measure 'UI Drop Pill Bg' = SWITCH ( [UI Drop Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI Drop Pill Fg' = SWITCH ( [UI Drop Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI Collection Pill Level' = VAR c = [Collection Rate] RETURN SWITCH ( TRUE (), ISBLANK ( c ), -1, c >= [Target Collection], 0, c >= 0.85, 1, 2 )
		isHidden

	/// UI5: BI review
	measure 'UI Collection Pill' = FORMAT ( [Collection Rate], "0%" ) & " collected, target 95%"
		isHidden

	/// UI5: BI review
	measure 'UI Collection Pill Bg' = SWITCH ( [UI Collection Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI Collection Pill Fg' = SWITCH ( [UI Collection Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI Compliance Pill Level' = VAR c = [SLA Compliance] RETURN SWITCH ( TRUE (), ISBLANK ( c ), -1, c >= [Target SLA Compliance], 0, c >= 0.85, 1, 2 )
		isHidden

	/// UI5: BI review
	measure 'UI Compliance Pill' = IF ( ISBLANK ( [SLA Compliance] ), "none resolved yet", FORMAT ( [SLA Compliance], "0%" ) & " in SLA, target 95%" )
		isHidden

	/// UI5: BI review
	measure 'UI Compliance Pill Bg' = SWITCH ( [UI Compliance Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI Compliance Pill Fg' = SWITCH ( [UI Compliance Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI Quarantine Pill Level' = IF ( [Quarantined Rows] > 0, 1, 0 )
		isHidden

	/// UI5: BI review
	measure 'UI Quarantine Pill' = IF ( [Quarantined Rows] > 0, "! " & FORMAT ( DISTINCTCOUNT ( mart_quarantine[dataset] ), "0" ) & " datasets affected", "✓ Quarantine empty" )
		isHidden

	/// UI5: BI review
	measure 'UI Quarantine Pill Bg' = SWITCH ( [UI Quarantine Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI Quarantine Pill Fg' = SWITCH ( [UI Quarantine Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI Failing Pill Level' = IF ( [Failing Rules] > 0, 2, 0 )
		isHidden

	/// UI5: BI review
	measure 'UI Failing Pill' = IF ( [Failing Rules] > 0, "✕ " & [UI Rules Total], "✓ All rules pass" )
		isHidden

	/// UI5: BI review
	measure 'UI Failing Pill Bg' = SWITCH ( [UI Failing Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI Failing Pill Fg' = SWITCH ( [UI Failing Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI Defect Pill Level' = IF ( [EUR At Risk] > 0, 2, 0 )
		isHidden

	/// UI5: BI review
	measure 'UI Defect Pill' = IF ( [EUR At Risk] > 0, "✕ Leakage to investigate", "✓ No data-defect leakage" )
		isHidden

	/// UI5: BI review
	measure 'UI Defect Pill Bg' = SWITCH ( [UI Defect Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI Defect Pill Fg' = SWITCH ( [UI Defect Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'UI Partner Pill Level' = IF ( [Unknown Partner Cost EUR] > 0, 1, 0 )
		isHidden

	/// UI5: BI review
	measure 'UI Partner Pill' = IF ( [Unknown Partner Cost EUR] > 0, "! Needs matching", "✓ All matched" )
		isHidden

	/// UI5: BI review
	measure 'UI Partner Pill Bg' = SWITCH ( [UI Partner Pill Level], 0, "#E3F6EE", 1, "#FDF1D6", 2, "#FDE2E2", "#F1F3F6" )
		isHidden

	/// UI5: BI review
	measure 'UI Partner Pill Fg' = SWITCH ( [UI Partner Pill Level], 0, "#0F7A53", 1, "#92600A", 2, "#B42318", "#4B5563" )
		isHidden

	/// UI5: BI review
	measure 'Color Crash Share' = IF ( [Crash Share] > [Limit Crash Share], "#D9363E", "#2F6FDB" )
		isHidden

	/// UI5: BI review
	measure 'Color Aging' =
			SWITCH ( MAX ( mart_customer_360[payment_age_order] ),
				1, "#F9C4A8", 2, "#F4996F", 3, "#F06A35", 4, "#C2461A", "#8C2F10" )
		isHidden

	/// UI5: BI review
	measure 'Color Attention' = IF ( SELECTEDVALUE ( Attention[Severity] ) <= 1, "#FDE2E2", IF ( SELECTEDVALUE ( Attention[Severity] ) = 2, "#FDF1D6" ) )
		isHidden

	/// UI5: BI review
	measure 'Font Attention' = SWITCH ( SELECTEDVALUE ( Attention[Severity] ), 1, "#B42318", 2, "#92600A", "#111827" )
		isHidden

	/// UI5: BI review
	measure 'UI Attention Count' = FORMAT ( COUNTROWS ( Attention ), "0" ) & " open items"
		isHidden

	/// UI6: BI review
	measure 'DQ Failure Rate' = DIVIDE ( SUM ( mart_dq_health[rows_failed] ), SUM ( mart_dq_health[rows_checked] ) )
		formatString: 0.00%
		isHidden

	/// UI6: BI review
	measure 'Color Failure' = IF ( [DQ Failure Rate] > 1 - [Target DQ Pass], "#D9363E", "#2F6FDB" )
		isHidden

	/// UI7: aggregate view
	measure 'Attention Items' = COUNTROWS ( Attention )
		formatString: #,0
		isHidden

	/// UI7: aggregate view
	measure 'Rows Failed' = CALCULATE ( SUM ( mart_dq_health[rows_failed] ), mart_dq_health[status] <> "PASS" )
		formatString: #,0
		isHidden

	/// UI7: aggregate view
	measure 'Case EUR' = SUM ( mart_recon_mismatches[amount_at_risk_eur] )
		formatString: € #,0
		isHidden

	/// UI7: aggregate view
	measure 'Avg Open Hours' = CALCULATE ( AVERAGE ( mart_incidents[open_hours] ), mart_incidents[status] <> "RESOLVED" )
		formatString: #,0.0
		isHidden

	/// UI7: aggregate view
	measure 'Customers With Dropped Calls' = CALCULATE ( [Customer Count], mart_customer_360[dropped_calls] > 0 )
		formatString: #,0
		isHidden

	/// UI7: aggregate view
	measure 'Customers With App Crashes' = CALCULATE ( [Customer Count], mart_customer_360[app_crashes] > 0 )
		formatString: #,0
		isHidden

	/// UI7: aggregate view
	measure 'Customers With Plan Changes' = CALCULATE ( [Customer Count], mart_customer_360[plan_changes] > 0 )
		formatString: #,0
		isHidden

	column MeasureHost
		dataType: string
		isHidden
		lineageTag: 5d2a1421-b621-4790-8a07-c9c8015e5f7f
		summarizeBy: none
		sourceColumn: MeasureHost

	partition _Measures = m
		mode: import
		source = #table(type table [MeasureHost = text], {})

