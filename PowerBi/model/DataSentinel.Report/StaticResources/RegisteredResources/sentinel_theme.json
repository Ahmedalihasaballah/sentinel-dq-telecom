{
  "name": "DataSentinel light",
  "dataColors": [
    "#2F6FDB",
    "#1FAE7A",
    "#6B5BD6",
    "#F06A35",
    "#F2B33D",
    "#0EA5E9",
    "#D9363E",
    "#64748B",
    "#A78BFA",
    "#14B8A6"
  ],
  "foreground": "#111827",
  "foregroundNeutralSecondary": "#6B7280",
  "foregroundNeutralTertiary": "#9CA3AF",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F7FA",
  "backgroundNeutral": "#E6E8EC",
  "tableAccent": "#2F6FDB",
  "good": "#1FAE7A",
  "neutral": "#F2B33D",
  "bad": "#D9363E",
  "maximum": "#1FAE7A",
  "center": "#F2B33D",
  "minimum": "#D9363E",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Bold",
      "color": "#111827"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B7280"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6E8EC"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "alignment": "left",
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "bold": true,
            "fontSize": 12
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9
          }
        ],
        "padding": [
          {
            "top": 14,
            "bottom": 12,
            "left": 18,
            "right": 18
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EEF0F3"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "fontSize": 9,
            "showTitle": false,
            "defaultToCircle": true
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "bold": true,
            "fontSize": 9,
            "outlineStyle": 2
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F9FAFB"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF0F3"
              }
            },
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#E6E8EC"
              }
            },
            "rowPadding": 6
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "rowPadding": 8
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 9,
            "bold": true
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    }
  }
}