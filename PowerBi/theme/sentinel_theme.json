{
  "name": "DataSentinel sketch",
  "dataColors": [
    "#C98B4C",
    "#E5E6EA",
    "#E2B341",
    "#F6CDD1",
    "#2061A8",
    "#A87F00",
    "#9AA5B1",
    "#7FA3D1",
    "#D9A57A",
    "#5C7A99"
  ],
  "foreground": "#2B2B2B",
  "foregroundNeutralSecondary": "#6B6B6B",
  "foregroundNeutralTertiary": "#9A9A9A",
  "background": "#FFFFFF",
  "backgroundLight": "#FBEFC6",
  "backgroundNeutral": "#E5E6EA",
  "tableAccent": "#E2B341",
  "good": "#2E9E5B",
  "neutral": "#E2B341",
  "bad": "#D64545",
  "maximum": "#D9F0E0",
  "center": "#FBEFC6",
  "minimum": "#F6CDD1",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#6B6B6B"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#2B2B2B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#2B2B2B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#6B6B6B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3A3A3A"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "alignment": "center",
            "fontColor": {
              "solid": {
                "color": "#2B2B2B"
              }
            },
            "bold": true
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#FBEFC6"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#2B2B2B"
              }
            },
            "bold": true
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5E6EA"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#FBEFC6"
              }
            },
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#FBEFC6"
              }
            },
            "bold": true
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}