[0m18:07:31.241250 [debug] [Thread-4 (]: On model.dbt_sentinel.mart_network_daily: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.7", "databricks_sql_connector_version": "4.4.0", "profile_name": "dbt_sentinel", "target_name": "dev", "invocation_id": "9791fc2a-8cc0-4183-a8f0-eb996f102373", "node_id": "model.dbt_sentinel.mart_network_daily"} */

  
    
        create or replace table `data_sentinel`.`gold`.`mart_network_daily`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- Dashboard 4: network load per day and record type.
select
    usage_date, usage_date_key, event_type,
    count(*) as records,
    count(distinct msisdn_hash) as active_numbers,
    sum(duration_sec) / 60.0 as minutes,
    sum(data_mb) as data_mb,
    sum(case when call_result = 'DROPPED' then 1 else 0 end) as dropped,
    sum(case when call_result = 'DROPPED' then 1 else 0 end) / nullif(count(*), 0) as drop_rate
from `data_sentinel`.`gold`.`fact_usage`
group by usage_date, usage_date_key, event_type
  
[0m18:07:31.244783 [debug] [Thread-3 (]: On model.dbt_sentinel.mart_cell_quality: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.7", "databricks_sql_connector_version": "4.4.0", "profile_name": "dbt_sentinel", "target_name": "dev", "invocation_id": "9791fc2a-8cc0-4183-a8f0-eb996f102373", "node_id": "model.dbt_sentinel.mart_cell_quality"} */

  
    
        create or replace table `data_sentinel`.`gold`.`mart_cell_quality`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- Dashboard 4: voice quality per cell (which towers drop calls).
select
    cell_id,
    count(*) as voice_calls,
    sum(case when call_result = 'DROPPED' then 1 else 0 end) as dropped_calls,
    sum(case when call_result = 'DROPPED' then 1 else 0 end) / nullif(count(*), 0) as drop_rate,
    sum(duration_sec) / 60.0 as minutes
from `data_sentinel`.`gold`.`fact_usage`
where event_type = 'VOICE' and cell_id is not null
group by cell_id
  
