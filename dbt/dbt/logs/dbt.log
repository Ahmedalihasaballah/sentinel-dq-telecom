)
select m.check_id, m.entity_type, m.entity_key, m.value_a, m.value_b, m.diff, m.amount_at_risk_eur, m.reason, m.run_id
from `data_sentinel`.`monitoring`.`recon_mismatches` m
join last_run l on m.run_id = l.run_id
  
