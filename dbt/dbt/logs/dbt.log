[0m18:04:37.132483 [debug] [Thread-6 (]: On model.dbt_sentinel.mart_dq_trend: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.7", "databricks_sql_connector_version": "4.4.0", "profile_name": "dbt_sentinel", "target_name": "dev", "invocation_id": "9791fc2a-8cc0-4183-a8f0-eb996f102373", "node_id": "model.dbt_sentinel.mart_dq_trend"} */

  
    
        create or replace table `data_sentinel`.`gold`.`mart_dq_trend`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- Dashboard 1: pass rate per day, dataset and quality dimension (gate rules only).
select
    to_date(run_ts) as run_date,
    dataset,
    dimension,
    sum(rows_checked) as rows_checked,
    sum(rows_failed) as rows_failed,
    1 - sum(rows_failed) / nullif(sum(rows_checked), 0) as pass_rate
from `data_sentinel`.`monitoring`.`dq_results`
where check_name = 'gate_rule'
group by to_date(run_ts), dataset, dimension
  
[0m18:04:37.135896 [debug] [Thread-4 (]: On model.dbt_sentinel.dim_plan: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.7", "databricks_sql_connector_version": "4.4.0", "profile_name": "dbt_sentinel", "target_name": "dev", "invocation_id": "9791fc2a-8cc0-4183-a8f0-eb996f102373", "node_id": "model.dbt_sentinel.dim_plan"} */

  
    
        create or replace table `data_sentinel`.`gold`.`dim_plan`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- DIMENSION: one row per plan VERSION (a plan keeps one row each time its price or limits change).
-- Input: silver.plan_history

-- Part 1: all real plan versions
select
    xxhash64(plan_id, valid_from) as plan_key,     -- a unique number made from plan_id + start date
    plan_id,
    version,
    valid_from,
    valid_to,
    is_current,
    plan_name,
    monthly_fee,
    data_gb,
    voice_minutes
from `data_sentinel`.`silver`.`plan_history`

union all

-- Part 2: one special row, key -1, for "plan unknown".
-- A row that has no matching plan points here, so we never lose a row.
select
    cast(-1 as bigint),
    cast(-1 as int),
    cast(1 as int),
    timestamp'1970-01-01 00:00:00',
    timestamp'9999-12-31 00:00:00',
    true,
    'UNKNOWN',
    cast(null as decimal(8,2)),
    cast(null as int),
    cast(null as int)
  
[0m18:04:37.143738 [debug] [Thread-3 (]: On model.dbt_sentinel.dim_date: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.7", "databricks_sql_connector_version": "4.4.0", "profile_name": "dbt_sentinel", "target_name": "dev", "invocation_id": "9791fc2a-8cc0-4183-a8f0-eb996f102373", "node_id": "model.dbt_sentinel.dim_date"} */

  
    
        create or replace table `data_sentinel`.`gold`.`dim_date`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- DIMENSION: one row per calendar day. It needs no input table: dbt builds the days itself.
-- The first and last day come from dbt_project.yml (date_start, date_end).

with days as (
    select explode(sequence(to_date('2024-01-01'), to_date('2028-12-31'), interval 1 day)) as full_date
)

select
    cast(date_format(full_date, 'yyyyMMdd') as int) as date_key,     -- 20261007 for 7 October 2026
    full_date,
    year(full_date) as year,
    quarter(full_date) as quarter,
    month(full_date) as month,
    date_format(full_date, 'MMMM') as month_name,
    date_format(full_date, 'yyyy-MM') as year_month,
    day(full_date) as day,
    dayofweek(full_date) as day_of_week,
    date_format(full_date, 'EEEE') as day_name,
    dayofweek(full_date) in (1, 7) as is_weekend
from days
  
