[0m19:36:54.591362 [debug] [Thread-4 (]: On model.dbt_sentinel.dim_plan: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.7", "databricks_sql_connector_version": "4.4.0", "profile_name": "dbt_sentinel", "target_name": "dev", "invocation_id": "7c496c73-6b03-4796-912b-0da31ffe37c6", "node_id": "model.dbt_sentinel.dim_plan"} */

  
    
        create or replace table `data_sentinel`.`gold`.`dim_plan`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- DIMENSION: one row per plan VERSION (a plan keeps one row each time its price or limits change).
-- Input: silver.plan_history

-- Part 1: all real plan versions
select
    xxhash64(plan_id, valid_from) as plan_key,     -- a unique number made from plan_id + start date
    plan_id,
    version,
    valid_from,
    valid_to,
    is_current,
    plan_name,
    monthly_fee,
    data_gb,
    voice_minutes
from `data_sentinel`.`silver`.`plan_history`

union all

-- Part 2: one special row, key -1, for "plan unknown".
-- A row that has no matching plan points here, so we never lose a row.
select
    cast(-1 as bigint),
    cast(-1 as int),
    cast(1 as int),
    timestamp'1970-01-01 00:00:00',
    timestamp'9999-12-31 00:00:00',
    true,
    'UNKNOWN',
    cast(null as decimal(8,2)),
    cast(null as int),
    cast(null as int)
  
