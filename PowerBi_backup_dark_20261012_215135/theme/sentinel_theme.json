{
  "name": "DataSentinel dark cobalt",
  "dataColors": [
    "#2563EB",
    "#22D3EE",
    "#60A5FA",
    "#818CF8",
    "#93C5FD",
    "#0EA5E9",
    "#64748B",
    "#A5B4FC",
    "#38BDF8",
    "#1D4ED8"
  ],
  "foreground": "#E2E8F0",
  "foregroundNeutralSecondary": "#94A3B8",
  "foregroundNeutralTertiary": "#64748B",
  "background": "#111A2E",
  "backgroundLight": "#16223A",
  "backgroundNeutral": "#1E293B",
  "tableAccent": "#2563EB",
  "good": "#2563EB",
  "neutral": "#22D3EE",
  "bad": "#EF4444",
  "maximum": "#2563EB",
  "center": "#1E3A8A",
  "minimum": "#991B1B",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#E2E8F0"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#E2E8F0"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#111A2E"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 55
          }
        ],
        "title": [
          {
            "alignment": "left",
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "bold": true
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1220"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B1220"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#93C5FD"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#111A2E"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#16223A"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": false,
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#93C5FD"
              }
            },
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#111A2E"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#16223A"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "background": {
              "solid": {
                "color": "#111A2E"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "card": [
          {
            "barShow": true,
            "barColor": {
              "solid": {
                "color": "#2563EB"
              }
            },
            "background": {
              "solid": {
                "color": "#111A2E"
              }
            }
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    }
  }
}