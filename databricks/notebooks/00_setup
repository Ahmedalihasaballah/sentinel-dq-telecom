
# DataSentinel - Databricks Setup
# Safe to rerun: creates missing objects only.

CATALOG = "datasentinel"

SCHEMAS = [
    "bronze",
    "quarantine",
    "silver",
    "recon",
    "gold",
]

# 1. Create the catalog only if it does not exist.
spark.sql(f"CREATE CATALOG IF NOT EXISTS {CATALOG}")

# 2. Create schemas only if they do not exist.
for schema in SCHEMAS:
    spark.sql(
        f"CREATE SCHEMA IF NOT EXISTS {CATALOG}.{schema}"
    )

# 3. Create the raw volume only if it does not exist.
spark.sql(
    f"CREATE VOLUME IF NOT EXISTS {CATALOG}.bronze.raw"
)

# 4. Verify the setup.
print("Catalog:")
spark.sql("SHOW CATALOGS").show(truncate=False)

print("Schemas:")
spark.sql(f"SHOW SCHEMAS IN {CATALOG}").show(truncate=False)

print("Raw volume:")
spark.sql(f"DESCRIBE VOLUME {CATALOG}.bronze.raw").show(
    truncate=False
)

print("DataSentinel setup verification completed.")