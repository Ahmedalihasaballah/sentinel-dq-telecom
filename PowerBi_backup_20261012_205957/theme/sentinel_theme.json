{
  "name": "DataSentinel",
  "dataColors": [
    "#1F5FA8",
    "#7FA3D1",
    "#B7C9E2",
    "#3C4F76",
    "#9AA5B1",
    "#5C7A99",
    "#C9D3DF",
    "#2F80C9",
    "#56677A",
    "#DDE3EA"
  ],
  "foreground": "#1B2A3A",
  "foregroundNeutralSecondary": "#5C6B7A",
  "foregroundNeutralTertiary": "#8C99A6",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F7FA",
  "backgroundNeutral": "#DDE3EA",
  "tableAccent": "#1F5FA8",
  "good": "#1F5FA8",
  "neutral": "#9AA5B1",
  "bad": "#D64545",
  "maximum": "#1F5FA8",
  "center": "#7FA3D1",
  "minimum": "#EAF1F9",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A3A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A3A"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A3A"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5C6B7A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DDE3EA"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B2A3A"
              }
            },
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5C6B7A"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}