model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation SourceStatus = "Databricks mart partitions are configured; authenticate in Power BI Desktop and refresh to load data."

annotation PBI_QueryOrder = ["mart_app_usage","mart_cell_quality","mart_customer_360","mart_dq_health","mart_dq_trend","mart_incidents","mart_network_daily","mart_partner_usage","mart_quarantine","mart_recon_mismatches","mart_revenue_assurance","mart_revenue_assurance_trend","Report Measures"]

ref table mart_app_usage
ref table mart_cell_quality
ref table mart_customer_360
ref table mart_dq_health
ref table mart_dq_trend
ref table mart_incidents
ref table mart_network_daily
ref table mart_partner_usage
ref table mart_quarantine
ref table mart_recon_mismatches
ref table mart_revenue_assurance
ref table mart_revenue_assurance_trend
ref table 'Report Measures'
