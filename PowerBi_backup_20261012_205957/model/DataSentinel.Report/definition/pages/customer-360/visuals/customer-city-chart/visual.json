{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "customer-city-chart",
  "position": {
    "width": 610,
    "y": 230,
    "z": 0,
    "x": 655,
    "tabOrder": 0,
    "height": 250
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "mart_customer_360"
                    }
                  },
                  "Property": "city"
                }
              },
              "queryRef": "mart_customer_360.city",
              "nativeQueryRef": "city",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Report Measures"
                    }
                  },
                  "Property": "Customer Count"
                }
              },
              "queryRef": "Report Measures.Customer Count",
              "nativeQueryRef": "Customer Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Customers by city'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  },
  "howCreated": "Copilot"
}